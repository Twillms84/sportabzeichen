{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-4">{{ title }}</h2>

    {# Tab-Navigation im IServ-Stil #}
    <ul class="nav nav-tabs mb-3">
        {% for tab in tabs %}
            <li class="nav-item">
                <a class="nav-link {% if tab.active %}active{% endif %}"
                   href="{{ path(tab.route) }}">
                    {{ tab.label }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# Hauptbereich #}
    <div class="card p-4 shadow-sm">
        <p>
            Diese Seite dient zur Verwaltung der Disziplinanforderungen
            und Teilnehmerdaten für das Deutsche Sportabzeichen.
        </p>

        <h5 class="mt-3">Verfügbare Funktionen:</h5>
        <ul>
            <li>📤 <a href="{{ path('sportabzeichen_admin_upload') }}">Anforderungsdatei hochladen</a></li>
            <li>📦 Import vorhandener Anforderungsdaten</li>
            <li>🧾 Übersicht importierter Jahrgänge</li>
        </ul>
    </div>
</div>
{% endblock %}
