{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-4">{{ title }}</h2>

    {# Tab-Navigation (optional, falls du sie schon nutzt) #}
    <ul class="nav nav-tabs mb-3">
        {% for tab in tabs %}
            <li class="nav-item">
                <a class="nav-link {% if tab.active %}active{% endif %}"
                   href="{{ path(tab.route) }}">
                    {{ tab.label }}
                </a>
            </li>
        {% endfor %}
    </ul>

    {# Hauptinhalt der Verwaltungsseite #}
    <div class="card p-4 shadow-sm">
        <p>
            Willkommen in der Verwaltung des Deutschen Sportabzeichens.<br>
            Hier können Disziplinanforderungen gepflegt, Jahrgänge verwaltet und CSV-Dateien importiert werden.
        </p>

        <h5 class="mt-4">Funktionen im Überblick:</h5>
        <ul class="list-unstyled mt-3">
            <li>📊 <a href="{{ url('crud_sportabzeichenrequirement_index') }}">Disziplinanforderungen anzeigen</a> – nach Jahr und Kategorie filterbar</li>
            <li>📤 <a href="{{ path('sportabzeichen_admin_upload') }}">CSV-Datei hochladen</a> – fügt neue Jahrgänge hinzu oder aktualisiert bestehende</li>
            <li>📤 <a href="{{ path('sportabzeichen_admin_upload_teilnehmer') }}">CSV-Datei hochladen</a> – Teilnehmerdaten um Alter und Geschlecht erweitern>            
            <li>🧾 Übersicht importierter Jahrgänge und Altersgruppen (in Arbeit)</li>
        </ul>
    </div>
</div>
{% endblock %}
