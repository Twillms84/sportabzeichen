{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-4">{{ title }}</h2>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">🏅 Leistungsanforderungen</h4>
                    <p>Verwalte die Disziplinen, Jahrgänge und Altersklassen.</p>

                    <a href="{{ path('crud_sportabzeichenrequirement_index') }}" class="btn btn-primary">
                        Anforderungen anzeigen
                    </a>

                    <a href="{{ path('sportabzeichen_admin_upload') }}" class="btn btn-outline-secondary mt-2">
                        CSV importieren
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title">📋 Prüfungen & Teilnehmer</h4>
                    <p>Prüfungen anlegen, Teilnehmer zuordnen und Leistungen eintragen.</p>

                    <a href="{{ path('crud_sportabzeichenexam_index') }}" class="btn btn-primary">
                        Prüfungen verwalten
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
            <div class="card-body">
                <h4 class="card-title">👥 Teilnehmerdaten</h4>
                <p>Teilnehmer importieren oder bearbeiten.</p>

                <a href="{{ path('crud_sportabzeichenparticipant_index') }}" class="btn btn-primary">
                    Teilnehmer anzeigen
                </a>

                <a href="{{ path('sportabzeichen_admin_upload_teilnehmer') }}" class="btn btn-outline-secondary mt-2">
                    CSV importieren
                </a>
            </div>
        </div>
    </div>

    </div>

    <div class="mt-4 p-3 bg-light border rounded">
        <h5>📊 Systemstatus</h5>
        <ul class="list-unstyled mb-0">
            <li>• Prüfungen insgesamt: <strong>{{ stats.exams }}</strong></li>
            <li>• Teilnehmer im System: <strong>{{ stats.participants }}</strong></li>
            <li>• Jahrgänge mit Anforderungen: <strong>{{ stats.requirementYears }}</strong></li>
        </ul>
    </div>

</div>
{% endblock %}
