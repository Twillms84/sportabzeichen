{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
Ergebnisse für {{ participant.vorname }} {{ participant.nachname }}
{% endblock %}

{% block page_content %}
<div class="content">

<h2>
    Ergebnisse: {{ participant.vorname }} {{ participant.nachname }}
    (Alter: {{ participant.age_year }}, Geschlecht: {{ participant.geschlecht }})
</h2>

<a href="{{ path('sportabzeichen_exam_participants', { id: examId }) }}"
   class="btn btn-outline-secondary mb-3">
    ← Zurück zur Teilnehmerliste
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Kategorie</th>
        <th>Disziplin</th>
        <th>Einheit</th>
        <th>Leistung</th>
        <th>Stufe</th>
        <th>Punkte</th>
    </tr>
    </thead>

    <tbody>
    {% for d in disciplines %}
        {% set r = results[d.id] ?? null %}
        <tr>
            <td>{{ d.kategorie }}</td>
            <td>{{ d.name }}</td>
            <td>{{ d.einheit }}</td>

            <td style="width: 160px;">
                <input type="number"
                       step="0.01"
                       class="form-control result-input"
                       data-discipline="{{ d.id }}"
                       value="{{ r.leistung ?? '' }}">
            </td>

            <td>{{ r.stufe ?? '-' }}</td>
            <td>{{ r.points ?? '-' }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

</div>

<script>
// AJAX Speichern beim Verlassen des Eingabefeldes
document.querySelectorAll(".result-input").forEach(function (fld) {
    fld.addEventListener("change", function () {
        const val = this.value;
        const did = this.dataset.discipline;

        fetch("{{ path('sportabzeichen_results_save') }}", {
            method: "POST",
            body: new URLSearchParams({
                ep_id: "{{ epId }}",
                discipline_id: did,
                leistung: val
            })
        }).then(res => res.text()).then(txt => {
            console.log("SAVE:", txt);
            location.reload(); // neu laden → Stufe/Punkte aktualisiert
        });
    });
});
</script>

{% endblock %}
