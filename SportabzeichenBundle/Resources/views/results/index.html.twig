{% extends "@IServCrud/default.html.twig" %}

{% block title %}Ergebnisse{% endblock %}

{% block body %}
<h1>Ergebnisse für {{ ep.participant.vorname }} {{ ep.participant.nachname }}</h1>

<a href="{{ path('sportabzeichen_add_result', {ep: ep.id}) }}" class="btn btn-primary mb-3">
    Neue Leistung eintragen
</a>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Disziplin</th>
        <th>Kategorie</th>
        <th>Auswahlnummer</th>
        <th>Leistung</th>
        <th>Stufe</th>
    </tr>
    </thead>
    <tbody>
    {% for r in results %}
        <tr>
            <td>{{ r.disziplin }}</td>
            <td>{{ r.kategorie }}</td>
            <td>{{ r.auswahlnummer }}</td>
            <td>{{ r.leistung }}</td>
            <td>{{ r.stufe }}</td>
        </tr>
    {% else %}
        <tr><td colspan="5">Noch keine Ergebnisse eingetragen.</td></tr>
    {% endfor %}
    </tbody>
</table>

{% endblock %}
