{% extends '@IServCore/page.html.twig' %}

{% block title %}
Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})
{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2>🏅 Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})</h2>

    {# Klassenfilter #}
    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <label class="fw-bold me-2 mb-0">Klasse:</label>

        <select name="class" class="form-select w-auto d-inline">
            <option value="">(Alle Klassen)</option>
            {% for c in classes %}
                <option value="{{ c.klasse }}"
                    {% if selectedClass == c.klasse %} selected{% endif %}
                >
                    {{ c.klasse }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary">
            Filtern
        </button>
    </form>


    <table class="table table-bordered align-middle mt-4">
        <thead>
        <tr>
            <th>Name</th>
            <th>Alter</th>

            {% for category, items in disciplines %}
                <th>{{ category }}</th>
            {% endfor %}
        </tr>
        </thead>

        <tbody>

        {% for p in participants %}
            <tr>
                <td>{{ p.vorname }} {{ p.nachname }}</td>
                <td>{{ p.age_year }}</td>

                {% for category, items in disciplines %}
                    <td>

                        {# Auswahlfeld #}
                        <select class="form-select discipline-select"
                                data-ep="{{ p.ep_id }}">
                            <option value="">(keine Auswahl)</option>

                            {% for d in items %}
                                {% if d.altersklasse == p.altersklasse and d.geschlecht == p.gender %}
                                    <option value="{{ d.id }}"
                                        {% if results[p.ep_id][d.id] is defined %}
                                            selected
                                        {% elseif d.auswahlnummer == 1 %}
                                            selected
                                        {% endif %}
                                    >
                                        {{ d.name }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>

                        {# Leistungsfeld #}
                        {% set disc = (items|filter(i => i.altersklasse == p.altersklasse and i.geschlecht == p.gender))|first %}
                        {% set selectedLeistung = results[p.ep_id][disc.id].leistung ?? '' %}

                        <input type="number" step="0.01"
                               class="form-control mt-1 result-input"
                               data-ep="{{ p.ep_id }}"
                               value="{{ selectedLeistung }}">
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="text-end mt-3">
        <button id="saveAllBtn" class="btn btn-success btn-lg">
            💾 Alle Ergebnisse speichern
        </button>
    </div>

</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('@PulsRSportabzeichenBundle/js/results.js') }}"></script>
{% endblock %}
