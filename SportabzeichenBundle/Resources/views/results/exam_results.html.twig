{% extends '@IServCore/page.html.twig' %}

{% block title %}
Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})
{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2>🏅 Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})</h2>

    {# -------------------------------------- #}
    {# Klassenfilter                         #}
    {# -------------------------------------- #}
    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <label class="fw-bold me-2 mb-0">Klasse:</label>

        <select name="class" class="form-select w-auto d-inline">
            <option value="">(Alle Klassen)</option>
            {% for c in classes %}
                <option value="{{ c.klasse }}"
                    {% if selectedClass == c.klasse %}selected{% endif %}
                >
                    {{ c.klasse }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary">
            Filtern
        </button>
    </form>


    {# ------------------------------------------------------------ #}
    {# SPEICHER-FORMULAR FÜR ALLE ERGEBNISSE                       #}
    {# ------------------------------------------------------------ #}
    <form method="post" action="{{ path('sportabzeichen_results_save_all', {examId: exam.id}) }}">

        <table class="table table-bordered align-middle mt-4">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Alter</th>

                    {% for category, items in disciplines %}
                        <th>{{ category }}</th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>

            {% for p in participants %}
                <tr>
                    <td>{{ p.vorname }} {{ p.nachname }}</td>
                    <td>{{ p.age_year }}</td>

                    {% for category, items in disciplines %}

                        {# Ergebnisse des Schülers (oder leeres Array) #}
                        {% set epResults = results[p.ep_id] ?? {} %}

                        {# Filtere Disziplinen nach Alter + Geschlecht #}
                        {% set options = [] %}
                        {% for d in items %}
                            {% if d.altersklasse == p.altersklasse and d.geschlecht == p.gender %}
                                {% set options = options|merge([d]) %}
                            {% endif %}
                        {% endfor %}

                        {# Bestimme ausgewählte Disziplin (falls vorhanden) #}
                        {% set selectedDisc = null %}
                        {% for oid, data in epResults %}
                            {% set selectedDisc = oid %}
                        {% endfor %}

                        {# Bestimme gespeicherten Leistungswert #}
                        {% if selectedDisc %}
                            {% set selectedValue = epResults[selectedDisc].leistung %}
                        {% else %}
                            {% set selectedValue = '' %}
                        {% endif %}

                        <td>

                            {# Dropdown Auswahl #}
                            <select name="results[{{ p.ep_id }}][discipline]" class="form-select">
                                <option value="">(keine Auswahl)</option>
                                {% for d in options %}
                                    {% set isSelected = (selectedDisc and selectedDisc == d.id) %}
                                    {% set defaultSelect = (not selectedDisc and d.auswahlnummer == 1) %}

                                    <option value="{{ d.id }}"
                                        {% if isSelected or defaultSelect %}
                                            selected
                                        {% endif %}
                                    >
                                        {{ d.name }}
                                    </option>
                                {% endfor %}
                            </select>

                            {# Leistungs-Eingabefeld #}
                            <input type="number"
                                   name="results[{{ p.ep_id }}][leistung]"
                                   step="0.01"
                                   class="form-control mt-1"
                                   value="{{ selectedValue }}">
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success btn-lg">
                💾 Alle Ergebnisse speichern
            </button>
        </div>

    </form>

</div>
{% endblock %}
`
