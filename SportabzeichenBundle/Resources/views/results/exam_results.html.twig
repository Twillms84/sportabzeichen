{% extends '@IServCore/page.html.twig' %}

{% block title %}
Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})
{% endblock %}

{% block content %}

<div class="container mt-4">

    <h2>🏅 Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})</h2>

    {# Klassenfilter #}
    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <label class="fw-bold me-2 mb-0">Klasse:</label>

        <select name="class" class="form-select w-auto d-inline">
            <option value="">(Alle Klassen)</option>
            {% for c in classes %}
                <option value="{{ c.klasse }}"
                    {% if selectedClass == c.klasse %}selected{% endif %}
                >
                    {{ c.klasse }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary">Filtern</button>
    </form>

    {# Formular für alle Ergebnisse #}
    <form method="post" action="{{ path('sportabzeichen_results_save_all', {examId: exam.id}) }}">

        <table class="table table-bordered align-middle mt-4">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Alter</th>

                    {% for category, items in disciplines %}
                        <th>{{ category }}</th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
            {% for p in participants %}
                <tr>
                    <td>{{ p.vorname }} {{ p.nachname }}</td>
                    <td>{{ p.age_year }}</td>

                    {% for category, items in disciplines %}
                        {% set epResults = results[p.ep_id] ?? {} %}
                        {% set options = items|filter(i => i.altersklasse == p.altersklasse and i.geschlecht == p.gender) %}
                        {% set selectedDisc = epResults|keys|first ?? null %}
                        {% set selectedValue = (selectedDisc and epResults[selectedDisc] is defined)
                            ? epResults[selectedDisc].leistung
                            : '' %}

                        <td>
                            <select name="results[{{ p.ep_id }}][discipline]" class="form-select">
                                <option value="">(keine Auswahl)</option>
                                {% for d in options %}
                                    {% set hasResult = epResults[d.id] is defined %}
                                    <option value="{{ d.id }}"
                                        {% if hasResult %}
                                            selected
                                        {% elseif d.auswahlnummer == 1 %}
                                            selected
                                        {% endif %}
                                    >
                                        {{ d.name }}
                                    </option>
                                {% endfor %}
                            </select>

                            <input type="number"
                                name="results[{{ p.ep_id }}][leistung]"
                                step="0.01"
                                class="form-control mt-1"
                                value="{{ selectedValue }}">
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}

            </tbody>
        </table>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success btn-lg">
                💾 Alle Ergebnisse speichern
            </button>
        </div>

    </form>

</div>
{% endblock %}
