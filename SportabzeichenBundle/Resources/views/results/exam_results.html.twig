{% extends '@IServCore/page.html.twig' %}

{% block title %}
    Ergebnisse eingeben – {{ exam.exam_year }}
{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2>🏅 Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})</h2>

    <table class="table table-bordered align-middle mt-4">
        <thead>
            <tr>
                <th>Name</th>
                <th>Alter</th>

                {% for category, items in disciplines %}
                    <th>{{ category }}</th>
                {% endfor %}
            </tr>
        </thead>

        <tbody>

        {% for p in participants %}
            <tr>
                <td>{{ p.vorname }} {{ p.nachname }}</td>
                <td>{{ p.age_year }}</td>

                {% for category, items in disciplines %}
                    <td>

                        {# ---- DROPDOWN: Disziplin wählen ---- #}
                        <select class="form-select discipline-select"
                                data-ep="{{ p.ep_id }}"
                                data-category="{{ category }}">
                            <option value="">(keine Auswahl)</option>

                            {% for d in items %}
                                <option value="{{ d.id }}"
                                    {% if results[p.ep_id][d.id] is defined %}
                                        selected
                                    {% endif %}
                                >
                                    {{ d.name }}
                                </option>
                            {% endfor %}
                        </select>

                        {# ---- INPUT: Leistung ---- #}
                        {% set currentValue = '' %}
                        {% for d in items %}
                            {% if results[p.ep_id][d.id] is defined %}
                                {% set currentValue = results[p.ep_id][d.id].leistung %}
                            {% endif %}
                        {% endfor %}

                        <input type="number" step="0.01"
                               class="form-control mt-1 result-input"
                               data-ep="{{ p.ep_id }}"
                               value="{{ currentValue }}">
                    </td>
                {% endfor %}

            </tr>
        {% endfor %}

        </tbody>
    </table>

</div>

<script>
document.addEventListener("change", function(e) {

    // Eingabe wurde geändert → speichern
    if (e.target.classList.contains("result-input")) {

        let ep        = e.target.dataset.ep;
        let leistung  = e.target.value;

        // passende Disziplin auswählen
        let select    = e.target.parentNode.querySelector(".discipline-select");
        let discipline = select.value;

        // nichts ausgewählt → nicht speichern
        if (!discipline) return;

        fetch("{{ path('sportabzeichen_results_save') }}", {
            method: "POST",
            headers: {"Content-Type": "application/x-www-form-urlencoded"},
            body: new URLSearchParams({
                ep_id: ep,
                discipline_id: discipline,
                leistung: leistung
            })
        });
    }
});
</script>

{% endblock %}
