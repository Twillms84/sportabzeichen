{% extends '@IServCore/page.html.twig' %}

{% block title %}
    Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})
{% endblock %}

{% block content %}
<div class="container mt-4">

    <h2>🏅 Ergebnisse eingeben – {{ exam.exam_name }} ({{ exam.exam_year }})</h2>

    {# Klassenfilter #}
    <form method="get" class="mb-3 d-flex align-items-center gap-2">
        <label class="fw-bold me-2 mb-0">Klasse:</label>

        <select name="class" class="form-select w-auto d-inline">
            <option value="">(Alle Klassen)</option>
            {% for c in classes %}
                <option value="{{ c.klasse }}"
                    {% if selectedClass == c.klasse %}selected{% endif %}
                >
                    {{ c.klasse }}
                </option>
            {% endfor %}
        </select>

        <button type="submit" class="btn btn-primary">Filtern</button>
    </form>


    {# FORMULAR FÜR MASSENSPEICHERN #}
    <form method="post" action="{{ path('sportabzeichen_results_save_all', {examId: exam.id}) }}">

        <table class="table table-bordered align-middle mt-4">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Alter</th>

                    {% for category, items in disciplines %}
                        <th>{{ category }}</th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
            {% for p in participants %}

                {% set epResults = results[p.ep_id] ?? {} %}

                <tr>
                    <td>{{ p.vorname }} {{ p.nachname }}</td>
                    <td>{{ p.age_year }}</td>

                    {% for category, items in disciplines %}

                        {% set options = [] %}
                        {% for d in items %}
                            {% if d.altersklasse == p.altersklasse and d.geschlecht == p.gender %}
                                {% set options = options|merge([d]) %}
                            {% endif %}
                        {% endfor %}

                        {% set selectedDisc = null %}
                        {% for did, row in epResults %}
                            {% set selectedDisc = did %}
                        {% endfor %}

                        {% if selectedDisc %}
                            {% set selectedValue = epResults[selectedDisc].leistung %}
                        {% else %}
                            {% set selectedValue = '' %}
                        {% endif %}

                        <td>
                            <select name="results[{{ p.ep_id }}][discipline]" class="form-select">
                                <option value="">(keine Auswahl)</option>

                                {% for d in options %}
                                    {% set preselect = (selectedDisc and selectedDisc == d.id) or
                                                       (not selectedDisc and d.auswahlnummer == 1) %}
                                    <option value="{{ d.id }}"
                                        {% if preselect %}selected{% endif %}
                                    >
                                        {{ d.name }}
                                    </option>
                                {% endfor %}
                            </select>

                            <input type="number"
                                   name="results[{{ p.ep_id }}][leistung]"
                                   step="0.01"
                                   class="form-control mt-1"
                                   value="{{ selectedValue }}">
                        </td>

                    {% endfor %}
                </tr>

            {% endfor %}
            </tbody>
        </table>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-success btn-lg">
                💾 Alle Ergebnisse speichern
            </button>
        </div>

    </form>

</div>
{% endblock %}
