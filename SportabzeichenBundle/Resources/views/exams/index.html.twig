{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    🏅 Sportabzeichen Prüfungen
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-4">Sportabzeichen Prüfungen – {{ jahr }}</h2>

    {# =================== FILTERBEREICH =================== #}
    <form method="get" class="form-inline mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Klasse</label>
                <select name="klasse" class="form-select">
                    <option value="">Alle Klassen</option>
                    {% for k in klassen %}
                        <option value="{{ k }}" {% if selectedKlasse == k %}selected{% endif %}>{{ k }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Geschlecht</label>
                <select name="geschlecht" class="form-select">
                    <option value="">Alle Geschlechter</option>
                    <option value="MALE" {% if selectedGeschlecht == 'MALE' %}selected{% endif %}>Männlich</option>
                    <option value="FEMALE" {% if selectedGeschlecht == 'FEMALE' %}selected{% endif %}>Weiblich</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Altersklasse</label>
                {% set used_classes = [] %}
                {% for p in participants %}
                    {% if p.altersklasse is defined and p.altersklasse not in used_classes %}
                        {% set used_classes = used_classes|merge([p.altersklasse]) %}
                    {% endif %}
                {% endfor %}
                <select name="altersklasse" class="form-select">
                    <option value="">Alle Altersklassen</option>
                    {% for ak in used_classes|sort %}
                        <option value="{{ ak }}" {% if selectedAltersklasse == ak %}selected{% endif %}>{{ ak }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Disziplin</label>
                <select name="disziplin" class="form-select">
                    <option value="">Alle Disziplinen</option>
                    {% for cat, diszList in disciplineOptions %}
                        {% set cat_lower = cat|lower %}
                        {% for dis in diszList %}
                            <option value="{{ dis.name }}" {% if selectedDisziplin == dis.name %}selected{% endif %}>
                                {{ dis.name }} ({{ cat_lower|capitalize }})
                            </option>
                        {% endfor %}
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filter setzen</button>
            </div>
        </div>
    </form>

    {# =================== TABELLE DER TEILNEHMER =================== #}
    <form id="exam-form">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Klasse</th>
                    <th>Ausdauer</th>
                    <th>Kraft</th>
                    <th>Koordination</th>
                    <th>Schnelligkeit</th>
                    <th>Schwimmnachweis</th>
                    <th>Punkte</th>
                </tr>
            </thead>
            <tbody>
                {% for p in participants %}
                    <tr data-id="{{ p.id }}">
                        <td>
                            <strong>{{ p.vorname }} {{ p.nachname }}</strong><br>
                            <small>({{ p.geschlecht_text }}, {{ p.altersklasse }})</small>
                        </td>

                        <td>{{ p.klasse ?? '–' }}</td>

                        {% for cat in ['ENDURANCE', 'FORCE', 'COORDINATION', 'RAPIDNESS'] %}
                            {% set cat_lower = cat|lower %}
                            <td style="min-width: 150px;">
                                <select class="form-select form-select-sm discipline-select mb-1" data-cat="{{ cat_lower }}">
                                    <option value="">–</option>
                                    {% for dis in disciplineOptions[cat] ?? disciplineOptions[cat_lower] ?? [] %}
                                        <option value="{{ dis.name }}">{{ dis.name }}</option>
                                    {% endfor %}
                                </select>
                                <input type="text" class="form-control form-control-sm result-input"
                                       data-cat="{{ cat_lower }}" placeholder="Ergebnis">
                            </td>
                        {% endfor %}

                        <td class="text-center">
                            <input type="checkbox" class="form-check-input swim-check">
                        </td>

                        <td class="points fw-bold text-center">0</td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center text-muted">Keine Teilnehmer gefunden.</td></tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="mt-3 text-end">
            <button type="button" id="save-btn" class="btn btn-success"
                    data-save-url="{{ path('sportabzeichen_exams_save') }}">
                💾 Speichern
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('bundles/pulsrsportabzeichen/js/exam.js') }}"></script>
{% endblock %}
