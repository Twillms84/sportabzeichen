{% extends "@IServCrud/default.html.twig" %}

{% block title %}Sportabzeichen – Prüfungen{% endblock %}

{% block body %}
<h1>Sportabzeichen – Prüfungen</h1>

<a href="{{ path('crud_sportabzeichenexam_new') }}" class="btn btn-primary mb-3">
    Neue Prüfung anlegen
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Datum</th>
        <th>Jahr</th>
        <th>Teilnehmer</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    {% for exam in items %}
        <tr>
            <td>{{ exam.id }}</td>
            <td>{{ exam.examDate ? exam.examDate|date('d.m.Y') : '-' }}</td>
            <td>{{ exam.examYear }}</td>
            <td>{{ exam.examParticipants|length }}</td>
            <td>
                <a href="{{ path('sportabzeichen_exam_participants', { id: exam.id }) }}"
                   class="btn btn-sm btn-secondary">Teilnehmer</a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="5">Keine Prüfungen vorhanden.</td></tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
