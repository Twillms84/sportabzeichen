{% extends "@IServCore/page.html.twig" %}

{% block title %}
    Teilnehmer – {{ exam.examName }} ({{ exam.examYear }})
{% endblock %}

{% block body %}
<h1>Teilnehmer – {{ exam.examName }} ({{ exam.examYear }})</h1>

<a href="{{ path('sportabzeichen_exam_add_participant', {id: exam.id}) }}" class="btn btn-primary mb-3">
    Teilnehmer hinzufügen
</a>

<form method="post"
      action="{{ path('sportabzeichen_exam_auto_add_participants', { id: exam.id }) }}"
      onsubmit="return confirm('Alle fehlenden Teilnehmer automatisch hinzufügen?');">

    <button class="btn btn-warning mb-3">
        🔄 Fehlende automatisch hinzufügen
    </button>
</form>

<a href="{{ path('sportabzeichen_exam_add_participant', { id: exam.id }) }}"
   class="btn btn-primary mb-3 ms-2">
    ➕ Manuell hinzufügen
</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>TN-ID</th>
        <th>Name</th>
        <th>Alter im Jahr</th>
        <th>Ergebnisse</th>
    </tr>
    </thead>

    <tbody>
    {% for ep in participants %}
        <tr>
            <td>{{ ep.id }}</td>
            <td>{{ ep.vorname }} {{ ep.nachname }}</td>
            <td>{{ ep.age_year }}</td>
            <td>
                <a href="{{ path('sportabzeichen_results_edit', {
                    examId: exam.id,
                    epId: ep.id
                }) }}" class="btn btn-sm btn-secondary">
                    Ergebnisse eintragen
                </a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="4">Noch keine Teilnehmer.</td></tr>
    {% endfor %}
    </tbody>

</table>
{% endblock %}
