{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-3">{{ title }}</h2>

    <div class="alert alert-info">
        Erfasse hier die Disziplinleistungen der Teilnehmer für das Deutsche Sportabzeichen.<br>
        Punkte werden automatisch berechnet: 🥇 = 3 Punkte, 🥈 = 2 Punkte, 🥉 = 1 Punkt.
    </div>

    <div class="mb-3">
        <label for="categoryFilter" class="form-label fw-bold">🔍 Kategorie filtern:</label>
        <select id="categoryFilter" class="form-select" style="max-width: 250px;">
            <option value="">Alle anzeigen</option>
            <option value="ENDURANCE">Ausdauer</option>
            <option value="FORCE">Kraft</option>
            <option value="COORDINATION">Koordination</option>
            <option value="RAPIDNESS">Schnelligkeit</option>
        </select>
    </div>

    <table class="table table-sm table-bordered table-striped align-middle shadow-sm" id="examTable">
        <thead class="table-light">
            <tr>
                <th style="width: 25%">Name</th>
                <th style="width: 15%">Ausdauer</th>
                <th style="width: 15%">Kraft</th>
                <th style="width: 15%">Koordination</th>
                <th style="width: 15%">Schnelligkeit</th>
                <th style="width: 10%">Gesamtpunkte</th>
                <th style="width: 15%">🏊 Schwimmnachweis</th>
            </tr>
        </thead>
        <tbody>
            {% for p in participants %}
                {% set geschlecht = p.geschlecht == 'm' ? 'MALE' : (p.geschlecht == 'w' ? 'FEMALE' : '') %}
                {% set altersklasse = p.altersklasse ?? '' %}
                {% set reqs = requirements[geschlecht][altersklasse] ?? {} %}

                <tr data-participant="{{ p.import_id }}">
                    <td>
                        <strong>{{ p.nachname }}, {{ p.vorname }}</strong><br>
                        <small class="text-muted">
                            {% if p.geschlecht %}{{ p.geschlecht|upper }}{% endif %}
                            {% if p.alter %} ({{ p.alter }} J.){% endif %}
                        </small>
                    </td>

                    {% for cat in ['ENDURANCE', 'FORCE', 'COORDINATION', 'RAPIDNESS'] %}
                        {% set disziplinen = reqs[cat] ?? [] %}
                        <td class="category-cell text-center" data-category="{{ cat }}">
                            {% if disziplinen is not empty %}
                                <select class="form-select form-select-sm discipline-select mb-1 mx-auto"
                                        style="width: 130px;">
                                    {% for r in disziplinen %}
                                        <option value="{{ loop.index0 }}"
                                                data-bronze="{{ r.bronze }}"
                                                data-silber="{{ r.silber }}"
                                                data-gold="{{ r.gold }}"
                                                data-berechnungsart="{{ r.berechnungsart }}"
                                                data-punktefeld="{{ r.punktefeld ? '1' : '0' }}">
                                            {{ r.auswahlnummer }}. {{ r.disziplin }}
                                        </option>
                                    {% endfor %}
                                </select>

                                {% set first = disziplinen[0] %}
                                {% if first.punktefeld %}
                                    <input type="number" min="0" max="3" class="form-control form-control-sm result-input mx-auto"
                                           placeholder="Punkte" style="width: 130px;" />
                                {% else %}
                                    <input type="number" step="0.01" class="form-control form-control-sm result-input mx-auto"
                                           placeholder="Ergebnis" style="width: 130px;" />
                                {% endif %}

                                <div class="points mt-1 small text-muted">0 P.</div>
                            {% else %}
                                <span class="text-muted small">–</span>
                            {% endif %}
                        </td>
                    {% endfor %}

                    <td class="total-points text-center fw-bold">0</td>

                    <td class="text-center">
                        {% if p.swim_status %}
                            ✅ gültig bis {{ p.swim_valid_until }}
                        {% else %}
                            ❌ nicht vorhanden
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const filterSelect = document.getElementById("categoryFilter");
    const table = document.getElementById("examTable");

    // Kategorie filtern
    filterSelect.addEventListener("change", () => {
        const value = filterSelect.value;
        table.querySelectorAll("tbody tr").forEach(row => {
            if (!value) {
                row.style.display = "";
                return;
            }

            const hasCategory = Array.from(row.querySelectorAll(".category-cell"))
                .some(td => td.getAttribute("data-category") === value && td.querySelector("select"));
            row.style.display = hasCategory ? "" : "none";
        });
    });

    // Punkteberechnung
    function updateTotalPoints(row) {
        let total = 0;
        row.querySelectorAll(".points").forEach(p => {
            const num = parseInt(p.textContent);
            if (!isNaN(num)) total += num;
        });
        row.querySelector(".total-points").textContent = total;
    }

    table.querySelectorAll(".result-input").forEach(input => {
        input.addEventListener("input", e => {
            const td = e.target.closest("td");
            const select = td.querySelector(".discipline-select");
            const pointsDisplay = td.querySelector(".points");
            const row = e.target.closest("tr");

            if (!select) return;

            const selected = select.options[select.selectedIndex];
            const berechnungsart = selected.dataset.berechnungsart;
            const punktefeld = selected.dataset.punktefeld === '1';

            let value = parseFloat(e.target.value);
            let points = 0;

            if (punktefeld) {
                points = Math.max(0, Math.min(3, value));
            } else if (!isNaN(value)) {
                const bronze = parseFloat(selected.dataset.bronze);
                const silber = parseFloat(selected.dataset.silber);
                const gold = parseFloat(selected.dataset.gold);

                if (berechnungsart === "GREATER") {
                    if (value >= gold) points = 3;
                    else if (value >= silber) points = 2;
                    else if (value >= bronze) points = 1;
                } else if (berechnungsart === "SMALLER") {
                    if (value <= gold) points = 3;
                    else if (value <= silber) points = 2;
                    else if (value <= bronze) points = 1;
                }
            }

            pointsDisplay.textContent = `${points} P.`;
            updateTotalPoints(row);
        });
    });
});
</script>
{% endblock %}
