{% extends "@IServCore/page.html.twig" %}

{% block page_title %}
    {{ title }}
{% endblock %}

{% block page_content %}
<div class="content">
    <h2 class="mb-4">{{ title }}</h2>

    <div class="card shadow-sm p-4">
        <p>Hier können die Leistungen der Teilnehmer:innen des Deutschen Sportabzeichens eingetragen und bewertet werden.</p>

        <table class="table table-striped table-bordered align-middle mt-3">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Ausdauer</th>
                    <th>Kraft</th>
                    <th>Koordination</th>
                    <th>Schnelligkeit</th>
                    <th>Punkte</th>
                    <th>Schwimmnachweis</th>
                </tr>
            </thead>
            <tbody>
            {% for teilnehmer in participants %}
                {% set reqs = requirements[teilnehmer.geschlecht][teilnehmer.altersklasse] ?? {} %}

                {% if reqs is empty %}
                    <tr>
                        <td>{{ teilnehmer.vorname }} {{ teilnehmer.nachname }} <small class="text-muted">({{ teilnehmer.alter }} J.)</small></td>
                        <td colspan="6" class="text-center text-muted">Keine Anforderungen für {{ teilnehmer.altersklasse }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td>
                            <strong>{{ teilnehmer.vorname }} {{ teilnehmer.nachname }}</strong><br>
                            <small class="text-muted">({{ teilnehmer.geschlecht == 'MALE' ? 'm' : 'w' }}, {{ teilnehmer.alter }} J.)</small>
                        </td>

                        {% set categories = ['ENDURANCE', 'FORCE', 'COORDINATION', 'RAPIDNESS'] %}
                        {% set total_points = 0 %}

                        {% for cat in categories %}
                            {% set disziplinen = reqs[cat] ?? [] %}
                            <td style="width: 200px;">
                                {% if disziplinen is not empty %}
                                    <select name="disziplin_{{ teilnehmer.import_id }}_{{ cat }}" class="form-select form-select-sm mb-1" style="width: 100%;">
                                        {% for d in disziplinen|sort((a,b) => a.auswahlnummer <=> b.auswahlnummer) %}
                                            <option value="{{ d.disziplin }}">
                                                {{ d.disziplin }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <input type="text" class="form-control form-control-sm" name="wert_{{ teilnehmer.import_id }}_{{ cat }}"
                                           placeholder="Ergebnis eingeben" style="width: 100%;">
                                {% else %}
                                    <span class="text-muted small">–</span>
                                {% endif %}
                            </td>
                        {% endfor %}

                        <td class="text-center fw-bold">
                            {{ total_points }}
                        </td>

                        <td class="text-center">
                            {% if teilnehmer.swim_status %}
                                ✅ <small>gültig bis {{ teilnehmer.swim_valid_until|date('Y') }}</small>
                            {% else %}
                                ❌ <small>nicht vorhanden</small>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
// Platzhalter für Berechnungslogik (später AJAX)
document.querySelectorAll('input[name^="wert_"]').forEach(input => {
    input.addEventListener('change', e => {
        const val = parseFloat(e.target.value.replace(',', '.'));
        if (!isNaN(val)) {
            // Hier später: Berechnung nach bronze/silber/gold
            console.log('Eingabewert für', e.target.name, val);
        }
    });
});
</script>
{% endblock %}

